{
  // Cloudflare Workers 部署配置。由 GitHub Actions 使用（见 .github/workflows/deploy-workers.yml）。
  "name": "xingbo-static-hosting",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/public",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xingbo-static-hosting",
      "database_id": "1888419d-d7c4-4b45-b6b4-60d22d8a8c33"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "xingbo-static-hosting"
    }
  ],
  "vars": {
    "APP_ID": "xingbo-static-hosting"
  },
  // APP_SECRET 是 secret，不要用 vars 明文写：workflow 里用 wrangler secret put 注入。
  "workers_dev": true
}
