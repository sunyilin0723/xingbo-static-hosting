{
  // Cloudflare Workers 部署配置（参考）。
  // 本项目通过 Cloudflare API 直接部署（见 README「部署到 Cloudflare Workers」），
  // 本文件等价描述了相同的 bindings / 兼容标志，供 wrangler CLI 用户使用。
  "name": "xingbo-static-hosting",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/public",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xingbo-static-hosting",
      "database_id": "<创建后填入 D1 database id>",
      "migrations_dir": "db/migrations-d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "xingbo-hosting-r2-9afd2a08"
    }
  ],
  "vars": {
    "APP_ID": "xingbo-static-hosting"
  },
  // APP_SECRET 是 secret，不要用 vars 明文写：
  //   wrangler secret put APP_SECRET
  "workers_dev": true
}
